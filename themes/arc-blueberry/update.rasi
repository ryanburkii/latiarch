/* LatiArch Rofi Update Menu Configuration - arc-blueberry theme */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    terminal: "ghostty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "󰀻 Apps";
    display-run: "󰆍 Run";
    display-window: "󰖯 Windows";
    display-emoji: "😀 Emojis";
    sidebar-mode: true;
    font: "JetBrains Mono Nerd Font 14";
    fullscreen: false;
}

* {
    bg-col: #111422;
    bg-col-light: #313b62;
    border-col: #f38cec;
    selected-col: #f38cec;
    blue: #69c3ff;
    fg-col: #bcc1dc;
    fg-col2: #f38cec;
    grey: #313b62;
    width: 300;
    font: "JetBrains Mono Nerd Font 14";
    border-radius: 0px;
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color: inherit;
    markup: true;
}

window {
    height: 450px;
    border: 3px;
    border-color: @border-col;
    border-radius: 0px;
    background-color: @bg-col;
    padding: 8px;
    margin: 0px;
}

mainbox {
    background-color: @bg-col;
    border-radius: 0px;
    padding: 8px;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col-light;
    text-color: @fg-col;
    border: 2px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 8px;
    margin: 0px 0px 10px 0px;
}

prompt {
    background-color: @blue;
    text-color: @bg-col;
    border-radius: 0px;
    padding: 4px 8px;
    margin: 0px 8px 0px 0px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    background-color: inherit;
    text-color: inherit;
    placeholder-color: @grey;
    placeholder: "Search...";
    border-radius: 0px;
    padding: 4px;
}

listview {
    background-color: @bg-col;
    columns: 1;
    lines: 8;
    border-radius: 0px;
    padding: 8px;
    margin: 0px;
}

element {
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 0px;
    padding: 8px;
    margin: 2px;
}

element-icon {
    size: 24px;
}

element selected {
    background-color: @selected-col;
    text-color: @bg-col;
    border-radius: 0px;
    padding: 8px;
    margin: 2px;
}

mode-switcher {
    background-color: @bg-col-light;
    text-color: @fg-col;
    border-radius: 0px;
    padding: 4px;
    margin: 0px 0px 10px 0px;
}

button {
    background-color: @bg-col-light;
    text-color: @fg-col;
    border: 2px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 4px 8px;
    margin: 2px;
}

button selected {
    background-color: @selected-col;
    text-color: @bg-col;
    border: 2px;
    border-color: @selected-col;
}

message {
    background-color: @bg-col-light;
    border: 2px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 8px;
    margin: 0px;
}

textbox {
    background-color: @bg-col-light;
    text-color: @fg-col;
    border-radius: 0px;
    padding: 8px;
}

error-message {
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 0px;
    padding: 8px;
}
