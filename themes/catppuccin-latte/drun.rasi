/* LatiArch Rofi DRUN Configuration - Catppuccin Latte theme */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    terminal: "ghostty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "󰀻 Apps";
    display-run: "󰆍 Run";
    display-window: "󰖯 Windows";
    display-emoji: "😀 Emojis";
    sidebar-mode: true;
    font: "JetBrains Mono Nerd Font 14";
    fullscreen: false;
}

* {
    bg-col: #eff1f5;
    bg-col-light: #dce0e8;
    border-col: #4c4f69;
    selected-col: #1e66f5;
    blue: #1e66f5;
    fg-col: #4c4f69;
    fg-col2: #1e66f5;
    grey: #9ca0b0;
    width: 600;
    font: "JetBrains Mono Nerd Font 14";
    border-radius: 0px;
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color: inherit;
}

window {
    height: 500px;
    border: 3px;
    border-color: @border-col;
    border-radius: 0px;
    background-color: @bg-col;
    padding: 8px;
    margin: 0px;
}

mainbox {
    background-color: @bg-col;
    border-radius: 0px;
    padding: 8px;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col-light;
    text-color: @fg-col;
    border: 2px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 8px;
    margin: 0px 0px 10px 0px;
}

prompt {
    background-color: @blue;
    text-color: @bg-col;
    border-radius: 0px;
    padding: 4px 8px;
    margin: 0px 8px 0px 0px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    background-color: inherit;
    text-color: inherit;
    placeholder-color: @grey;
    placeholder: "Search applications...";
    border-radius: 0px;
    padding: 4px;
}

listview {
    background-color: @bg-col;
    columns: 2;
    lines: 8;
    border-radius: 0px;
    padding: 8px;
    margin: 0px;
}

element {
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 0px;
    padding: 8px;
    margin: 2px;
}

element-icon {
    size: 24px;
}

element selected {
    background-color: @selected-col;
    text-color: @bg-col;
    border-radius: 0px;
    padding: 8px;
    margin: 2px;
}

mode-switcher {
    background-color: @bg-col-light;
    text-color: @fg-col;
    border-radius: 0px;
    padding: 4px;
    margin: 0px 0px 10px 0px;
}

button {
    background-color: @bg-col-light;
    text-color: @fg-col;
    border: 2px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 4px 8px;
    margin: 2px;
}

button selected {
    background-color: @selected-col;
    text-color: @bg-col;
    border: 2px;
    border-color: @selected-col;
}

message {
    background-color: @bg-col-light;
    border: 2px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 8px;
    margin: 0px;
}

textbox {
    background-color: @bg-col-light;
    text-color: @fg-col;
    border-radius: 0px;
    padding: 8px;
}

error-message {
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 0px;
    padding: 8px;
}
