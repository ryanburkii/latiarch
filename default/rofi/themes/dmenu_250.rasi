/* LatiArch Dmenu 250 Theme - Compact menu style */

* {
    bg-col: #1e1e2e;
    bg-col-light: #2a2a40;
    border-col: #89b4fa;
    selected-col: #89b4fa;
    blue: #89b4fa;
    fg-col: #cdd6f4;
    fg-col2: #f5c2e7;
    grey: #6c7086;
    width: 250;
    font: "JetBrains Mono Nerd Font 12";
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color: inherit;
}

window {
    height: 300px;
    border: 2px; 
    border-color: @border-col;
    border-radius: 0px;
    background-color: @bg-col;
    padding: 8px;
    margin: 0px;
}

mainbox {
    background-color: @bg-col;
    border-radius: 0px;
    padding: 4px;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col-light;
    text-color: @fg-col;
    border: 1px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 4px;
    margin: 0px 0px 4px 0px;
}

prompt {
    background-color: @blue;
    text-color: @bg-col;
    border-radius: 0px;
    padding: 2px 4px;
    margin: 0px 4px 0px 0px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    background-color: inherit;
    text-color: inherit;
    placeholder-color: @grey;
    placeholder: "Search...";
    border-radius: 0px;
    padding: 2px;
}

listview {
    background-color: @bg-col;
    columns: 1;
    lines: 10;
    border-radius: 0px;
    padding: 2px;
    margin: 0px;
}

element {
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 0px;
    padding: 4px;
    margin: 1px;
}

element-icon {
    size: 16px;
}

element selected {
    background-color: @selected-col;
    text-color: @bg-col;
    border-radius: 0px;
    padding: 4px;
    margin: 1px;
}

mode-switcher {
    background-color: @bg-col-light;
    text-color: @fg-col;
    border-radius: 0px;
    padding: 2px;
    margin: 0px 0px 4px 0px;
}

button {
    background-color: @bg-col-light;
    text-color: @fg-col;
    border: 1px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 2px 4px;
    margin: 1px;
}

button selected {
    background-color: @selected-col;
    text-color: @bg-col;
    border: 1px;
    border-color: @selected-col;
}

message {
    background-color: @bg-col-light;
    border: 1px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 4px;
    margin: 0px;
}

textbox {
    background-color: @bg-col-light;
    text-color: @fg-col;
    border-radius: 0px;
    padding: 4px;
}

error-message {
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 0px;
    padding: 4px;
}
