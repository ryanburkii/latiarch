show_remove_menu() {
  case $(menu "Remove" "󰣇  Package\n  Web App\n  TUI\n󰸌  Theme\n󰈷  Fingerprint\n  Fido2" "" "" "install.rasi") in
  *Package*) terminal latiarch-pkg-remove ;;
  *Web*) present_terminal latiarch-webapp-remove ;;
  *TUI*) present_terminal latiarch-tui-remove ;;
  *Theme*) present_terminal latiarch-theme-remove ;;
  *Fingerprint*) present_terminal "latiarch-setup-fingerprint --remove" ;;
  *Fido2*) present_terminal "latiarch-setup-fido2 --remove" ;;
  *) show_main_menu ;;
  esac
}

show_update_menu() {
  case $(menu "Update" "<span font='latiarch'>&#xE800;</span> LatiArch\n  Config\n󰸌  Extra Themes\n  Process\n󰇅  Hardware\n  Password\n  Timezone" "" "" "update.rasi") in
  *LatiArch*) present_terminal latiarch-update ;;
  *Config*) show_update_config_menu ;;
  *Themes*) present_terminal latiarch-theme-update ;;
  *Process*) show_update_process_menu ;;
  *Hardware*) show_update_hardware_menu ;;
  *Timezone*) latiarch-cmd-tzupdate ;;
  *Password*) show_update_password_menu ;;
  *) show_main_menu ;;
  esac
}

show_update_process_menu() {
  case $(menu "Restart" "  Hypridle\n  Hyprsunset\n  Swayosd\n󰌧  Rofi\n󰍜  Waybar" "" "" "update.rasi") in
  *Hypridle*) latiarch-restart-hypridle ;;
  *Hyprsunset*) latiarch-restart-hyprsunset ;;
  *Swayosd*) latiarch-restart-swayosd ;;
  *Rofi*) latiarch-restart-rofi ;;
  *Waybar*) latiarch-restart-waybar ;;
  *) show_update_menu ;;
  esac
}

show_update_config_menu() {
  case $(menu "Use default config" "  Hyprland\n  Hypridle\n  Hyprlock\n  Hyprsunset\n󱣴  Plymouth\n  Swayosd\n󰌧  Rofi\n󰍜  Waybar" "" "" "update.rasi") in
  *Hyprland*) present_terminal latiarch-refresh-hyprland ;;
  *Hypridle*) present_terminal latiarch-refresh-hypridle ;;
  *Hyprlock*) present_terminal latiarch-refresh-hyprlock ;;
  *Hyprsunset*) present_terminal latiarch-refresh-hyprsunset ;;
  *Plymouth*) present_terminal latiarch-refresh-plymouth ;;
  *Swayosd*) present_terminal latiarch-refresh-swayosd ;;
  *Rofi*) present_terminal latiarch-refresh-rofi ;;
  *Waybar*) present_terminal latiarch-refresh-waybar ;;
  *) show_update_menu ;;
  esac
}

show_update_hardware_menu() {
  case $(menu "Restart" "  Audio\n󱚾  Wi-Fi\n󰂯  Bluetooth" "" "" "update.rasi") in
  *Audio*) present_terminal latiarch-restart-pipewire ;;
  *Wi-Fi*) present_terminal latiarch-restart-wifi ;;
  *Bluetooth*) present_terminal latiarch-restart-bluetooth ;;
  *) show_update_menu ;;
  esac
}

show_update_password_menu() {
  case $(menu "Update Password" "  Drive Encryption\n  User" "" "" "update.rasi") in
  *Drive*) present_terminal latiarch-drive-set-password ;;
  *User*) present_terminal passwd ;;
  *) show_update_menu ;;
  esac
}

show_system_menu() {
  case $(menu "System" "  Lock\n󱄄  Screensaver\n󰤄  Suspend\n  Relaunch\n󰜉  Restart\n󰐥  Shutdown" "" "" "system.rasi") in
  *Lock*) latiarch-lock-screen ;;
  *Screensaver*) latiarch-launch-screensaver force ;;
  *Suspend*) systemctl suspend ;;
  *Relaunch*) uwsm stop ;;
  *Restart*) systemctl reboot ;;
  *Shutdown*) systemctl poweroff ;;
  *) back_to show_main_menu ;;
  esac
}

show_main_menu() {
  local choice=$(menu "Go" "󰀻  Apps\n󰧑  Learn\n󱓞  Trigger\n  Style\n  Setup\n󰉉  Install\n󰭌  Remove\n  Update\n  About\n  System" "" "" "config.rasi")

  if [[ -z "$choice" ]]; then
    return 0
  fi

  go_to_menu "$choice"
}

go_to_menu() {

  if [[ -z "$1" ]]; then
    return 0
  fi

  case "${1,,}" in
  *apps*) rofi -show drun -theme "$HOME/.config/rofi/drun.rasi" ;;
  *learn*) show_learn_menu ;;
  *trigger*) show_trigger_menu ;;
  *share*) show_share_menu ;;
  *style*) show_style_menu ;;
  *theme*) show_theme_menu ;;
  *screenshot*) show_screenshot_menu ;;
  *screenrecord*) show_screenrecord_menu ;;
  *setup*) show_setup_menu ;;
  *power*) show_setup_power_menu ;;
  *install*) show_install_menu ;;
  *remove*) show_remove_menu ;;
  *update*) show_update_menu ;;
  *about*) latiarch-launch-about ;;
  *system*) show_system_menu ;;
  esac
}

if [[ -n "$1" ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi
