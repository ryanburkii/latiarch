#!/bin/bash

export PATH="$HOME/.local/share/latiarch/bin:$PATH"

# Set to true when going directly to a submenu, so we can exit directly
BACK_TO_EXIT=false

back_to() {
  local parent_menu="$1"

  if [[ "$BACK_TO_EXIT" == "true" ]]; then
    exit 0
  elif [[ -n "$parent_menu" ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"
  local theme="${5:-config.rasi}"

  read -r -a args <<<"$extra"

  if [[ -n "$preselect" ]]; then
    local index
    index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n "$index" ]]; then
      args+=("-a" "$index")
    fi
  fi
  echo -e "$options" | rofi -dmenu -theme "$HOME/.config/rofi/$theme" -p "$prompt" "${args[@]}"
}

terminal() {
  ghostty --class=LatiArch -e "$@"
}

present_terminal() {
  latiarch-launch-floating-terminal-with-presentation $1
}

open_in_editor() {
  notify-send "Editing config file" "$1"
  latiarch-launch-editor "$1"
}

install() {
  present_terminal "echo 'Installing $1...'; sudo pacman -S --noconfirm $2"
}

install_and_launch() {
  present_terminal "echo 'Installing $1...'; sudo pacman -S --noconfirm $2 && setsid gtk-launch $3"
}

install_font() {
  present_terminal "echo 'Installing $1...'; sudo pacman -S --noconfirm --needed $2 && sleep 2 && latiarch-font-set '$3'"
}

install_terminal() {
  present_terminal "latiarch-install-terminal $1"
}

aur_install() {
  present_terminal "echo 'Installing $1 from AUR...'; yay -S --noconfirm $2"
}

aur_install_and_launch() {
  present_terminal "echo 'Installing $1 from AUR...'; yay -S --noconfirm $2 && setsid gtk-launch $3"
}

show_learn_menu() {
  case $(menu "Learn" "  Keybindings\n  LatiArch\n  Hyprland\n󰣇  Arch\n  Neovim\n󱆃  Bash" "" "" "learn.rasi") in
  *Keybindings*) latiarch-menu-keybindings ;;
  *LatiArch*) latiarch-launch-webapp "https://learn.omacom.io/2/the-latiarch-manual" ;;
  *Hyprland*) latiarch-launch-webapp "https://wiki.hypr.land/" ;;
  *Arch*) latiarch-launch-webapp "https://wiki.archlinux.org/title/Main_page" ;;
  *Bash*) latiarch-launch-webapp "https://devhints.io/bash" ;;
  *Neovim*) latiarch-launch-webapp "https://www.lazyvim.org/keymaps" ;;
  *) show_main_menu ;;
  esac
}

show_trigger_menu() {
  case $(menu "Trigger" "  Capture\n  Share\n󰔎  Toggle" "" "" "trigger.rasi") in
  *Capture*) show_capture_menu ;;
  *Share*) show_share_menu ;;
  *Toggle*) show_toggle_menu ;;
  *) show_main_menu ;;
  esac
}

show_capture_menu() {
  case $(menu "Capture" "  Screenshot\n  Screenrecord\n󰃉  Color" "" "" "trigger.rasi") in
  *Screenshot*) show_screenshot_menu ;;
  *Screenrecord*) show_screenrecord_menu ;;
  *Color*) pkill hyprpicker || hyprpicker -a ;;
  *) show_trigger_menu ;;
  esac
}

show_screenshot_menu() {
  case $(menu "Screenshot" "  Region\n  Window\n  Display" "" "" "trigger.rasi") in
  *Region*) latiarch-cmd-screenshot ;;
  *Window*) latiarch-cmd-screenshot window ;;
  *Display*) latiarch-cmd-screenshot output ;;
  *) show_capture_menu ;;
  esac
}

show_screenrecord_menu() {
  case $(menu "Screenrecord" "  Region\n  Region + Audio\n  Display\n  Display + Audio" "" "" "trigger.rasi") in
  *"Region + Audio"*) latiarch-cmd-screenrecord region audio ;;
  *Region*) latiarch-cmd-screenrecord ;;
  *"Display + Audio"*) latiarch-cmd-screenrecord output audio ;;
  *Display*) latiarch-cmd-screenrecord output ;;
  *) show_capture_menu ;;
  esac
}

show_share_menu() {
  case $(menu "Share" "  Clipboard\n  File \n  Folder" "" "" "trigger.rasi") in
  *Clipboard*) terminal bash -c "latiarch-cmd-share clipboard" ;;
  *File*) terminal bash -c "latiarch-cmd-share file" ;;
  *Folder*) terminal bash -c "latiarch-cmd-share folder" ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_toggle_menu() {
  case $(menu "Toggle" "󱄄  Screensaver\n󰔎  Nightlight\n󱫖  Idle Lock\n󰍜  Top Bar" "" "" "trigger.rasi") in
  *Screensaver*) latiarch-toggle-screensaver ;;
  *Nightlight*) latiarch-toggle-nightlight ;;
  *Idle*) latiarch-toggle-idle ;;
  *Bar*) latiarch-toggle-waybar ;;
  *) show_trigger_menu ;;
  esac
}

show_style_menu() {
  local choice=$(menu "Style" "󰸌  Theme\n  Font\n  Background\n  Hyprland\n󱄄  Screensaver\n  About" "" "" "style.rasi")

  if [[ -z "$choice" ]]; then
    return 0
  fi

  case "$choice" in
  *Theme*) show_theme_menu ;;
  *Font*) show_font_menu ;;
  *Background*) latiarch-theme-bg-next ;;
  *Hyprland*) open_in_editor ~/.config/hypr/looknfeel.conf ;;
  *Screensaver*) open_in_editor ~/.config/latiarch/branding/screensaver.txt ;;
  *About*) open_in_editor ~/.config/latiarch/branding/about.txt ;;
  *) show_main_menu ;;
  esac
}

show_theme_menu() {
  theme=$(menu "Theme" "$(latiarch-theme-list)" "" "$(latiarch-theme-current)" "style.rasi")
  if [[ "$theme" == "CNCLD" || -z "$theme" ]]; then
    back_to show_style_menu
  else
    latiarch-theme-set "$theme"
  fi
}

show_font_menu() {
  theme=$(menu "Font" "$(latiarch-font-list)" "-w 350" "$(latiarch-font-current)" "style.rasi")
  if [[ "$theme" == "CNCLD" || -z "$theme" ]]; then
    back_to show_style_menu
  else
    latiarch-font-set "$theme"
  fi
}

show_setup_menu() {
  local options="  Audio\n  Wifi\n󰂯  Bluetooth\n󱐋  Power Profile\n󰍹  Monitors"
  [ -f ~/.config/hypr/bindings.conf ] && options="$options\n  Keybindings"
  [ -f ~/.config/hypr/input.conf ] && options="$options\n  Input"
  options="$options\n  Defaults\n󰱔  DNS\n  Security\n  Config"

  case $(menu "Setup" "$options" "" "" "setup.rasi") in
  *Audio*) $TERMINAL --class=Wiremix -e wiremix ;;
  *Wifi*)
    rfkill unblock wifi
    latiarch-launch-wifi
    ;;
  *Bluetooth*)
    rfkill unblock bluetooth
    blueberry
    ;;
  *Power*) show_setup_power_menu ;;
  *Monitors*) open_in_editor ~/.config/hypr/monitors.conf ;;
  *Keybindings*) open_in_editor ~/.config/hypr/bindings.conf ;;
  *Input*) open_in_editor ~/.config/hypr/input.conf ;;
  *Defaults*) open_in_editor ~/.config/uwsm/default ;;
  *DNS*) present_terminal latiarch-setup-dns ;;
  *Security*) show_setup_security_menu ;;
  *Config*) show_setup_config_menu ;;
  *) show_main_menu ;;
  esac
}

show_setup_power_menu() {
  profile=$(menu "Power Profile" "$(latiarch-powerprofiles-list)" "" "$(powerprofilesctl get)" "setup.rasi")

  if [[ "$profile" == "CNCLD" || -z "$profile" ]]; then
    back_to show_setup_menu
  else
    powerprofilesctl set "$profile"
  fi
}

show_setup_config_menu() {
  case $(menu "Setup" "  Hyprland\n  Hypridle\n  Hyprlock\n  Hyprsunset\n  Swayosd\n󰌧  Rofi\n󰍜  Waybar\n󰞅  XCompose" "" "" "setup.rasi") in
  *Hyprland*) open_in_editor ~/.config/hypr/hyprland.conf ;;
  *Hypridle*) open_in_editor ~/.config/hypr/hypridle.conf && latiarch-restart-hypridle ;;
  *Hyprlock*) open_in_editor ~/.config/hypr/hyprlock.conf ;;
  *Hyprsunset*) open_in_editor ~/.config/hypr/hyprsunset.conf && latiarch-restart-hyprsunset ;;
  *Swayosd*) open_in_editor ~/.config/swayosd/config.toml && latiarch-restart-swayosd ;;
  *Rofi*) open_in_editor ~/.config/rofi/config.rasi && latiarch-restart-rofi ;;
  *Waybar*) open_in_editor ~/.config/waybar/config.jsonc && latiarch-restart-waybar ;;
  *XCompose*) open_in_editor ~/.XCompose && latiarch-restart-xcompose ;;
  *) show_main_menu ;;
  esac
}

show_setup_security_menu() {
  case $(menu "Setup" "󰈷  Fingerprint\n  Fido2" "" "" "setup.rasi") in
  *Fingerprint*) present_terminal latiarch-setup-fingerprint ;;
  *Fido2*) present_terminal latiarch-setup-fido2 ;;
  *) show_setup_menu ;;
  esac
}

show_install_menu() {
  case $(menu "Install" "󰣇  Package\n󰣇  AUR\n  Web App\n  TUI\n  Service\n  Style\n󰵮  Development\n  Editor\n  Terminal\n󱚤  AI\n  Gaming" "" "" "install.rasi") in
  *Package*) terminal latiarch-pkg-install ;;
  *AUR*) terminal latiarch-pkg-aur-install ;;
  *Web*) present_terminal latiarch-webapp-install ;;
  *TUI*) present_terminal latiarch-tui-install ;;
  *Service*) show_install_service_menu ;;
  *Style*) show_install_style_menu ;;
  *Development*) show_install_development_menu ;;
  *Editor*) show_install_editor_menu ;;
  *Terminal*) show_install_terminal_menu ;;
  *AI*) show_install_ai_menu ;;
  *Gaming*) show_install_gaming_menu ;;
  *) show_main_menu ;;
  esac
}

show_install_service_menu() {
  case $(menu "Install" "  Dropbox\n  Tailscale\n󰟵  Bitwarden\n  Chromium Account" "" "" "install.rasi") in
  *Dropbox*) present_terminal latiarch-install-dropbox ;;
  *Tailscale*) present_terminal latiarch-install-tailscale ;;
  *Bitwarden*) install_and_launch "Bitwarden" "bitwarden bitwarden-cli" "bitwarden" ;;
  *Chromium*) present_terminal latiarch-install-chromium-google-account ;;
  *) show_install_menu ;;
  esac
}

show_install_editor_menu() {
  case $(menu "Install" "  VSCode\n  Cursor\n  Zed\n  Sublime Text\n  Helix\n  Emacs" "" "" "install.rasi") in
  *VSCode*) install_and_launch "VSCode" "visual-studio-code-bin" "code" ;;
  *Cursor*) install_and_launch "Cursor" "cursor-bin" "cursor" ;;
  *Zed*) install_and_launch "Zed" "zed" "dev.zed.Zed" ;;
  *Sublime*) aur_install_and_launch "Sublime Text" "sublime-text-4" "sublime_text" ;;
  *Helix*) install "Helix" "helix" ;;
  *Emacs*) install "Emacs" "emacs-wayland" && systemctl --user enable --now emacs.service ;;
  *) show_install_menu ;;
  esac
}

show_install_terminal_menu() {
  case $(menu "Install" "  Alacritty\n  Ghostty\n  Kitty" "" "" "install.rasi") in
  *Alacritty*) install_terminal "alacritty" ;;
  *Ghostty*) install_terminal "ghostty" ;;
  *Kitty*) install_terminal "kitty" ;;
  *) show_install_menu ;;
  esac
}

show_install_ai_menu() {
  ollama_pkg=$(
    (command -v nvidia-smi &>/dev/null && echo ollama-cuda) ||
      (command -v rocminfo &>/dev/null && echo ollama-rocm) ||
      echo ollama
  )

  case $(menu "Install" "󱚤  Claude Code\n󱚤  Gemini [AUR]\n󱚤  OpenAI Codex [AUR]\n󱚤  LM Studio\n󱚤  Ollama\n󱚤  Crush\n󱚤  opencode" "" "" "install.rasi") in
  *Claude*) install "Claude Code" "claude-code" ;;
  *OpenAI*) aur_install "OpenAI Codex" "openai-codex-bin" ;;
  *Gemini*) aur_install "Gemini" "gemini-cli" ;;
  *Studio*) install "LM Studio" "lmstudio" ;;
  *Ollama*) install "Ollama" $ollama_pkg ;;
  *Crush*) install "Crush" "crush-bin" ;;
  *opencode*) install "opencode" "opencode" ;;
  *) show_install_menu ;;
  esac
}

